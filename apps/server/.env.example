PORT=8080
JWT_SECRET=design-review-secret-key-2026
NODE_ENV=development
PUBLIC_API_ORIGIN=http://localhost:8080
WECHAT_WORK_WEBHOOK_URL=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# 品牌邀请会话 AI 设计方案总结（OpenAI-compatible Chat Completions）
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=your_server_side_api_key
# AI_MODEL=your_model_name
# 可选：加密后台保存的 AI API Key。生产环境请设置稳定的随机密钥；未设置时使用 JWT_SECRET 派生。
# AI_CONFIG_ENCRYPTION_KEY=your_stable_random_secret

# 数据库连接 (待你创建好数据库后在此填入)
# DB_TYPE=postgres 或 mysql
# DATABASE_URL=postgresql://user:password@localhost:5432/design_review_db
# MYSQL_URL=mysql://root:password@127.0.0.1:3306/design_review_db

# 阿里云 OSS 配置
OSS_REGION=oss-cn-guangzhou
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_CUSTOM_DOMAIN=
# 生图工作台必须使用 Redis + BullMQ；生产环境建议使用具备持久化与高可用的 Redis 服务。
REDIS_URL=redis://127.0.0.1:6379/0
IMAGE_STUDIO_GENERATION_CONCURRENCY=2
IMAGE_STUDIO_QUEUE_ATTEMPTS=4
IMAGE_STUDIO_UPSTREAM_TIMEOUT_MS=600000
# Worker 锁时间须大于单次上游等待周期，并由 BullMQ 延长；默认 10 分钟。
IMAGE_STUDIO_WORKER_LOCK_MS=600000
IMAGE_STUDIO_SHUTDOWN_GRACE_MS=25000
IMAGE_STUDIO_TEXT_CONCURRENCY=4
IMAGE_STUDIO_EXPORT_CONCURRENCY=1
IMAGE_STUDIO_MAX_ACTIVE_JOBS_PER_USER=5
IMAGE_STUDIO_DAILY_GENERATION_LIMIT=200
# 浏览器直传 OSS 时，在 Bucket CORS 中放行这些前端来源（多个来源用逗号分隔）
OSS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 生产环境必须关闭 Bucket 公共读/公共列举，原图只允许后端使用服务端密钥访问



# 腾讯云短信（只配置在服务端，不要提交真实密钥）

# 邮箱验证码（SMTP，仅配置在服务端，不要提交真实密码）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=创赢 <no-reply@example.com>
