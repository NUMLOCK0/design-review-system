{
  "name": "design-review-system-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "电商设计稿审核管理系统 (PC SSR前端 + 独立API后端 + UniApp微信小程序)",
  "scripts": {
    "dev:server": "pnpm --filter @design-review/server dev",
    "dev:web": "pnpm --filter @design-review/web dev",
    "restart:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-dev.ps1",
    "dev:mp": "pnpm --filter @design-review/uni-app dev:mp-weixin",
    "build:server": "pnpm --filter @design-review/server build",
    "build:web": "pnpm --filter @design-review/web build",
    "package:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-deploy.ps1",
    "build:mp": "pnpm --filter @design-review/uni-app build:mp-weixin"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
