{
  "name": "design-review-system-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "电商设计稿审核管理系统 (PC SSR前端 + 独立API后端 + UniApp微信小程序)",
  "scripts": {
    "dev:server": "pnpm --filter @design-review/server dev",
    "dev:server:retry": "node scripts/retry-mysql.mjs",
    "check:db": "node scripts/retry-mysql.mjs --check",
    "check:chat": "node scripts/check-chat-reliability.mjs",
    "migrate:collaboration": "pnpm --filter @design-review/server exec tsx ../../scripts/migrate-collaboration.ts",
    "check:collaboration": "pnpm --filter @design-review/server exec tsx ../../scripts/check-collaboration.ts",
    "check:intake": "pnpm --filter @design-review/server exec tsx ../../scripts/check-intake.ts",
    "setup:database": "pnpm --filter @design-review/server exec tsx ../../scripts/setup-database.ts",
    "dev:web": "pnpm --filter @design-review/web dev",
    "dev:up": "node scripts/dev-stack.mjs up",
    "dev:down": "node scripts/dev-stack.mjs down",
    "dev:status": "node scripts/dev-stack.mjs status",
    "dev:restart": "node scripts/dev-stack.mjs restart",
    "restart:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-dev.ps1",
    "dev:mp": "pnpm --filter @design-review/uni-app dev:mp-weixin",
    "build:server": "pnpm --filter @design-review/server build",
    "build:web": "pnpm --filter @design-review/web build",
    "check:order-applications": "pnpm --filter @design-review/server exec tsx ../../scripts/check-order-applications.ts",
    "migrate:order-applications": "pnpm --filter @design-review/server exec tsx ../../scripts/migrate-order-applications.ts",
    "migrate:order-evaluations": "pnpm --filter @design-review/server exec tsx ../../scripts/migrate-order-evaluations.ts",
    "migrate:image-urls": "pnpm --filter @design-review/server exec tsx ../../scripts/migrate-image-urls.ts",
    "migrate:reference-links": "pnpm --filter @design-review/server exec tsx ../../scripts/migrate-reference-link-items.ts",
    "package:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-deploy.ps1",
    "build:mp": "pnpm --filter @design-review/uni-app build:mp-weixin"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
